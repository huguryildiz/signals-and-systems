# --- macOS ---
.DS_Store
._*
.Spotlight-V100
.Trashes

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# --- Node ---
node_modules/

# --- Large / restricted source material (kept on disk, never tracked) ---
# Book.pdf is a cross-check reference only: never reproduced or redistributed.
source/Book.pdf
# 41 MB handwritten scan; too large for git history. Keep a local copy.
source/Lecture Notes.pdf

# --- Pipeline output that is not a deliverable ---
# notes/build.js and notes/editions.js write these so notes/topdf.js can turn them
# into PDFs. They are intermediates, regenerated by one command each.
dist/Lecture_Notes.html
dist/Student_Workbook.html
dist/Instructor_Solutions.html
dist/Formula_Reference.html
# Of the four printed editions only the lecture notes are tracked. The other three
# are regenerated by `cd notes && node editions.js` followed by the topdf run, and
# keeping them would write several megabytes of new binary into history on every
# rebuild — the reason the old release zip was removed. Decided 2026-07-27.
dist/Student_Workbook.pdf
dist/Instructor_Solutions.pdf
dist/Formula_Reference.pdf
# build/qa.js screenshot dump and build/textclash.js report.
shots/
textclash.json
# pdftoppm renders of the source pages, made for the visual audit.
pages/

# --- Scratch ---
_to_delete/
*.tmp

# Local working area: prompts, plans, session notes. Never tracked.
.claude/

# FUSE mount leftovers
.fuse_hidden*

# Project operating instructions: local working document, not tracked.
CLAUDE.md
