# --- macOS ---
.DS_Store
._*
.Spotlight-V100
.Trashes

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# --- Node ---
node_modules/

# --- Large / restricted source material (kept on disk, never tracked) ---
# The whole directory, not file by file. book.pdf is a cross-check reference only
# and is never reproduced or redistributed; the handwritten scan is 41 MB and too
# large for git history; and source/exams holds the examination papers themselves,
# which are the model for the drills and must never leave this machine. Naming the
# files one by one would let a new subdirectory in by default.
# Keep local copies; a fresh clone will not contain any of it.
source/

# --- Pipeline output that is not a deliverable ---
# notes/build.js and notes/editions.js write these so notes/topdf.js can turn them
# into PDFs. They are intermediates, regenerated by one command each.
dist/Lecture_Notes.html
dist/Student_Workbook.html
dist/Instructor_Solutions.html
dist/Formula_Reference.html
# The lecture notes, student workbook and formula reference PDFs are published
# deliverables and stay tracked. The instructor PDF remains a local build product
# and is regenerated by the topdf run; keeping it would write several megabytes
# of binary into history.
dist/Instructor_Solutions.pdf
# build/qa.js screenshot dump and build/textclash.js report.
shots/
textclash.json
# pdftoppm renders of the source pages, made for the visual audit.
pages/

# --- Scratch ---
_to_delete/
*.tmp
*.log

# impeccable design hook cache; config.json next to it is tracked.
.impeccable/hook.cache.json

# Local working area. Selected instruction and hook files are explicitly tracked;
# prompts, reports, source audits, and other working records remain ignored.
.claude/

# FUSE mount leftovers
.fuse_hidden*

# Project instruction files are explicitly tracked; ignore other local copies.
CLAUDE.md
AGENTS.md
DESIGN.md
PRODUCT.md

# Editor settings: a local convenience, not a property of the project.
.vscode/

# --- Public site build (web/build-site.js) ---
# Assembled from dist/ on every deploy; nothing in it is authored by hand.
site/
.vercel
# web/pyodide.js keeps the fetched Python runtime here between builds.
web/.cache/
.env*

# Working TODO: local working document, not tracked.
TODO.md
