{
  "description": "Block dependency installs and direct edits to generated files in this repository.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/tools/agent_guard.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
